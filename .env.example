# Android public configuration (RLS must remain enabled)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase CLI / server-side only. Never bundle these into the APK.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Edge Functions secrets only
SEPAY_WEBHOOK_SECRET=your-random-webhook-secret
SEPAY_WEBHOOK_API_KEY=your-sepay-webhook-api-key
SEPAY_API_TOKEN=your-sepay-api-token
SEPAY_API_BASE_URL=https://userapi-sandbox.sepay.vn/v2
SEPAY_ENVIRONMENT=sandbox
APP_TIME_ZONE=Asia/Ho_Chi_Minh
